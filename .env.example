# Copia este archivo a .env y define valores reales.
# NUNCA versiones el archivo .env.

# SQL Server
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=<definir, mínimo 8 caracteres con mayúscula, minúscula, número y símbolo>
MSSQL_PORT=1433

# API
API_PORT=8090
ConnectionStrings__Default=Server=db,1433;Database=Ingrata;User Id=sa;Password=<definir igual que MSSQL_SA_PASSWORD>;TrustServerCertificate=True;Encrypt=False
ASPNETCORE_ENVIRONMENT=Development

# JWT
Jwt__Key=<definir, mínimo 32 caracteres>
Jwt__ExpireMinutes=30
Jwt__Issuer=InventarioIngrata
Jwt__Audience=InventarioIngrata

# Aplicación
App__TimeZone=America/Mexico_City
App__PermitirMermaAlmacenista=true

# Alta inicial del Administrador (RD-05)
BOOTSTRAP_ADMIN_ID=<definir>
BOOTSTRAP_ADMIN_PASSWORD=<definir>

# CORS: origen del frontend en desarrollo
CORS_ORIGIN=http://localhost:4200
